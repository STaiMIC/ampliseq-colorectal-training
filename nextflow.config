/*
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ampliseq-colorectal-training — nextflow.config
    STaiMIC 16S microbiome practical
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow.enable.dsl = 2


process {

    cpus = 2
    memory = 6.GB
    time = '2.h'

    withName: 'CUTADAPT_BASIC' {
        cpus = 2
    }

    withName: 'DADA2_DENOISING' {
        cpus = 2
        memory = 6.GB
    }

}


docker {
    enabled = true
}


timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}


manifest {
    name = 'ampliseq-colorectal-training'
    version = '1.0.0'
}

wave {
    enabled = false
}
